{
  "name": "army3d",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter @army3d/shared build && pnpm -r --filter @army3d/server --filter @army3d/client build",
    "dev": "pnpm --filter @army3d/shared build && pnpm -r --parallel --filter @army3d/server --filter @army3d/client dev",
    "test": "pnpm -r --filter @army3d/shared --filter @army3d/server test",
    "test:e2e": "pnpm --filter @army3d/client test:e2e",
    "typecheck": "pnpm -r typecheck",
    "textures": "node scripts/fetch-polyhaven.mjs"
  }
}
